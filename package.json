{
  "name": "@dsh-user/dsh-dashboard",
  "version": "0.1.0",
  "description": "Dashboard UI plugin for DeepSeek Harness: an overview of all sessions, task progress, and metrics on one page.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.10"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.1-rc.2"
  }
}
